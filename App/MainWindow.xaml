<Window x:Class="ModuleOptimiser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Module Optimiser" Width="940" Height="620" MinWidth="720" MinHeight="460"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterScreen">

  <Border Background="#E61C1F26" CornerRadius="12" BorderBrush="#24FFFFFF" BorderThickness="1" Margin="8">
    <Grid Margin="18,14,18,18">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Title bar: drag anywhere on the title to move the window -->
      <Grid Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <TextBlock Text="Module Optimiser" FontSize="18" FontWeight="SemiBold"
                   Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
        <Button HorizontalAlignment="Right" Style="{StaticResource CloseButton}"
                Content="&#xE8BB;" Click="Close_Click" />
      </Grid>

      <!-- Toolbar -->
      <DockPanel Grid.Row="1" Margin="0,12,0,12">
        <Button Content="Open…" Style="{StaticResource AccentPill}" ToolTip="Open ModulesSaveData.json"
                Click="OpenButton_Click" />
        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12"
                   Foreground="{StaticResource SubtleTextBrush}"
                   Text="Load ModulesSaveData.json from your ZDPS Data folder" />
        <Border x:Name="ProgressTrack" DockPanel.Dock="Right" Width="220" Height="8" CornerRadius="4"
                Margin="14,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                Background="#33FFFFFF" Visibility="Collapsed">
          <Border x:Name="ProgressFill" Width="0" HorizontalAlignment="Left" CornerRadius="4"
                  Background="{StaticResource AccentBrush}" />
        </Border>
        <TextBlock x:Name="StatusText" Margin="14,0,0,0" VerticalAlignment="Center"
                   Foreground="{StaticResource SubtleTextBrush}" TextTrimming="CharacterEllipsis" />
      </DockPanel>

      <!-- Main area -->
      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="320" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Stat minimums -->
        <Border Style="{StaticResource Card}" Background="#D9101216" CornerRadius="10" Padding="14">
          <DockPanel>
            <!-- Profiles: pick to load. Icons: save over the selected one, new, delete. -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ComboBox x:Name="ProfileBox" DisplayMemberPath="Name" SelectionChanged="ProfileBox_SelectionChanged" />
              <Button Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource IconButton}" Height="32"
                      Content="&#xE74E;" FontSize="14" ToolTip="Save" Click="SaveProfile_Click" />
              <Button Grid.Column="2" Style="{StaticResource IconButton}" Height="32"
                      Content="&#xE710;" FontSize="14" ToolTip="New profile" Click="NewProfile_Click" />
              <Button Grid.Column="3" Style="{StaticResource IconButton}" Height="32"
                      Content="&#xE74D;" FontSize="14" ToolTip="Delete" Click="DeleteProfile_Click" />
            </Grid>
            <!-- Appears when "New profile" is pressed. Enter saves, Esc cancels. -->
            <TextBox x:Name="ProfileName" DockPanel.Dock="Top" Margin="0,0,0,8" Height="32" Padding="10,0"
                     Style="{StaticResource GlassInput}" VerticalContentAlignment="Center"
                     Tag="Name, then Enter" Visibility="Collapsed"
                     KeyDown="ProfileName_KeyDown" LostKeyboardFocus="ProfileName_LostKeyboardFocus" />
            <Button x:Name="FindButton" DockPanel.Dock="Bottom" Margin="0,10,0,0"
                    Content="Find loadouts" Style="{StaticResource AccentPill}"
                    HorizontalAlignment="Stretch" Click="FindButton_Click" />
            <ListBox x:Name="StatList" AllowDrop="True" Background="Transparent" BorderThickness="0"
                     Foreground="{StaticResource TextBrush}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="Padding" Value="0" />
                  <Setter Property="Margin" Value="0,2,0,2" />
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" Background="#14FFFFFF" CornerRadius="6" Padding="6,4">
                          <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#26FFFFFF" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="&#xE700;" FontFamily="{StaticResource IconFont}"
                               FontSize="14" Foreground="{StaticResource SubtleTextBrush}"
                               Margin="0,0,10,0" VerticalAlignment="Center" Cursor="SizeAll" />
                    <TextBox DockPanel.Dock="Right" Width="58" Height="32" VerticalAlignment="Center" Margin="8,0,0,0"
                             Padding="8,0" FontSize="14" MaxLength="2" Tag="min"
                             ToolTip="Minimum total" Style="{StaticResource GlassInput}"
                             VerticalContentAlignment="Center" Text="{Binding MinimumText, UpdateSourceTrigger=PropertyChanged}" />
                    <Image DockPanel.Dock="Left" Width="22" Height="22" Margin="0,0,8,0" Source="{Binding Icon}" />
                    <!-- Weight: drag the slider or type a number (0-100, decimals allowed) -->
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                      <TextBox DockPanel.Dock="Right" Width="58" Height="26" Margin="8,0,0,0" Padding="6,0"
                               FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"
                               Style="{StaticResource GlassInput}" VerticalContentAlignment="Center"
                               TextAlignment="Right" ToolTip="Weight" KeyDown="WeightBox_KeyDown"
                               Text="{Binding Weight, StringFormat={}{0:0.##}, UpdateSourceTrigger=LostFocus}" />
                      <Slider Style="{StaticResource GlassSlider}" Minimum="0" Maximum="100"
                              SmallChange="0.1" LargeChange="1"
                              Value="{Binding Weight, Mode=TwoWay}" />
                    </DockPanel>
                    <TextBlock Text="{Binding Label}" FontSize="12" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextBrush}" />
                  </DockPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>

        <!-- Results -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Background="#D9101216" CornerRadius="10" Padding="14">
          <DockPanel>
            <!-- Export, shown only once there are results -->
            <Button x:Name="SaveResultsButton" DockPanel.Dock="Top" HorizontalAlignment="Right" Margin="0,0,0,6"
                    Style="{StaticResource IconButton}" Height="30" Content="&#xEDE1;" FontSize="14"
                    ToolTip="Export results" Visibility="Collapsed" Click="SaveButton_Click" />
            <ListBox x:Name="ResultsList" Background="Transparent" BorderThickness="0"
                     Foreground="{StaticResource TextBrush}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <!-- Plain rows: no selection highlight, the cards draw themselves -->
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter Margin="0,0,6,0" />
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListBox.ItemContainerStyle>
            </ListBox>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
