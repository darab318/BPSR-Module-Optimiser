<Window x:Class="ModuleOptimiser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Module Optimiser" Width="940" Height="620" MinWidth="720" MinHeight="460"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterScreen">

  <Border Background="#E61C1F26" CornerRadius="12" BorderBrush="#24FFFFFF" BorderThickness="1" Margin="8">
    <Grid Margin="18,14,18,18">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Title bar: drag anywhere on the title to move the window -->
      <Grid Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <TextBlock Text="Module Optimiser" FontSize="18" FontWeight="SemiBold"
                   Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
        <Button HorizontalAlignment="Right" Style="{StaticResource CloseButton}"
                Content="&#xE8BB;" Click="Close_Click" />
      </Grid>

      <!-- Toolbar -->
      <DockPanel Grid.Row="1" Margin="0,12,0,12">
        <Button Content="Open modules file" Style="{StaticResource AccentPill}" Click="OpenButton_Click" />
        <Border x:Name="ProgressTrack" DockPanel.Dock="Right" Width="220" Height="8" CornerRadius="4"
                Margin="14,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                Background="#33FFFFFF" Visibility="Collapsed">
          <Border x:Name="ProgressFill" Width="0" HorizontalAlignment="Left" CornerRadius="4"
                  Background="{StaticResource AccentBrush}" />
        </Border>
        <TextBlock x:Name="StatusText" Margin="14,0,0,0" VerticalAlignment="Center"
                   Foreground="{StaticResource SubtleTextBrush}"
                   Text="Open your ModulesSaveData.json to begin." />
      </DockPanel>

      <!-- Main area -->
      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="320" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Stat minimums -->
        <Border Style="{StaticResource Card}" Background="#D9101216" CornerRadius="10" Padding="14">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Minimum totals" Style="{StaticResource SectionTitle}" />
            <!-- Weight profiles: pick one to load it; type a name and Save to store the current sliders -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ComboBox x:Name="ProfileBox" DisplayMemberPath="Name" SelectionChanged="ProfileBox_SelectionChanged" />
              <Button Grid.Column="1" Margin="6,0,0,0" Content="Delete" Style="{StaticResource PillButton}"
                      Click="DeleteProfile_Click" />
            </Grid>
            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="ProfileName" Style="{StaticResource GlassInput}" VerticalContentAlignment="Center"
                       ToolTip="Profile name. Use an existing name to overwrite it." />
              <Button Grid.Column="1" Margin="6,0,0,0" Content="Save profile" Style="{StaticResource PillButton}"
                      Click="SaveProfile_Click" />
            </Grid>
            <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                       Style="{StaticResource FieldLabel}"
                       Text="Each slider sets that stat's weight (1-100); the list keeps itself sorted by weight. Dragging a row gives it a weight between its new neighbours. Type a minimum to require it." />
            <Button x:Name="FindButton" DockPanel.Dock="Bottom" Margin="0,10,0,0"
                    Content="Find loadouts" Style="{StaticResource AccentPill}"
                    HorizontalAlignment="Stretch" Click="FindButton_Click" />
            <ListBox x:Name="StatList" AllowDrop="True" Background="Transparent" BorderThickness="0"
                     Foreground="{StaticResource TextBrush}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="Padding" Value="0" />
                  <Setter Property="Margin" Value="0,2,0,2" />
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" Background="#14FFFFFF" CornerRadius="6" Padding="6,4">
                          <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#26FFFFFF" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="&#xE700;" FontFamily="{StaticResource IconFont}"
                               FontSize="14" Foreground="{StaticResource SubtleTextBrush}"
                               Margin="0,0,10,0" VerticalAlignment="Center" Cursor="SizeAll" />
                    <TextBox DockPanel.Dock="Right" Width="52" Height="28" VerticalAlignment="Center" Margin="8,0,0,0"
                             ToolTip="Minimum total (optional)" Style="{StaticResource GlassInput}"
                             VerticalContentAlignment="Center" Text="{Binding MinimumText, UpdateSourceTrigger=PropertyChanged}" />
                    <Image DockPanel.Dock="Left" Width="22" Height="22" Margin="0,0,8,0" Source="{Binding Icon}" />
                    <!-- Weight slider: only shown when "Custom weights" is on -->
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                      <TextBlock DockPanel.Dock="Right" Width="30" Margin="8,0,0,0" TextAlignment="Right"
                                 VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                 Foreground="{StaticResource AccentBrush}" Text="{Binding Weight}" />
                      <Slider Style="{StaticResource GlassSlider}" Minimum="1" Maximum="100"
                              SmallChange="1" LargeChange="5" IsSnapToTickEnabled="True" TickFrequency="1"
                              Value="{Binding Weight, Mode=TwoWay}" />
                    </DockPanel>
                    <TextBlock Text="{Binding Label}" FontSize="12" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextBrush}" />
                  </DockPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>

        <!-- Results -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Background="#D9101216" CornerRadius="10" Padding="14">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Save results" Style="{StaticResource PillButton}"
                    Click="SaveButton_Click" />
            <TextBlock DockPanel.Dock="Top" Text="Best loadouts" Style="{StaticResource SectionTitle}" />
            <ListBox x:Name="ResultsList" Background="Transparent" BorderThickness="0"
                     Foreground="{StaticResource TextBrush}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <!-- Plain rows: no selection highlight, the cards draw themselves -->
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter Margin="0,0,6,0" />
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListBox.ItemContainerStyle>
            </ListBox>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
